import {socialLinks} from '../data/site';
---
<footer><div class="wrap foot"><div><a class="brand" href="/">Papy AI<span>.</span></a><p>IA, créativité et conseils concrets.<br/>Pour créer plus, et s’amuser plus.</p></div><div><b>Explorer</b><a href="/prompts">Prompts</a><a href="/astuces">Astuces</a><a href="/ressources">Ressources</a></div><div><b>Me retrouver</b>{socialLinks.map(x=><a href={x.url} target="_blank" rel="noreferrer">{x.name} ↗</a>)}</div></div><div class="wrap legal"><span>© {new Date().getFullYear()} Papy AI</span><span>Fabriqué avec des idées, de l’IA et un café tiède.</span></div></footer><style>footer{margin-top:60px;border-top:1px solid rgba(255,255,255,.1);background:rgba(5,4,25,.5);padding:62px 0 26px}.foot{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}.brand{font:800 2rem Syne}.brand span{color:#ef551a}.foot p,.foot a{color:#aaa8ba}.foot>div:not(:first-child){display:flex;flex-direction:column;gap:9px}.foot b{margin-bottom:5px}.foot a:hover{color:#fff}.legal{display:flex;justify-content:space-between;color:#737181;font-size:.76rem;border-top:1px solid rgba(255,255,255,.08);margin-top:45px;padding-top:20px}@media(max-width:640px){.foot{grid-template-columns:1fr 1fr}.foot>div:first-child{grid-column:1/-1}.legal{display:block}.legal span{display:block;margin-top:5px}}</style>
