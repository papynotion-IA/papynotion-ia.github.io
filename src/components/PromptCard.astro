---
import type {Prompt} from '../data/prompts';
const {prompt:p, compact=false}:{prompt:Prompt,compact?:boolean}=Astro.props;
---
<article class="card prompt-card" data-search={`${p.title} ${p.description} ${p.tool} ${p.category}`.toLowerCase()} data-category={`${p.tool}|${p.category}`}><div class="tag-row"><span class="badge badge-orange">{p.tool}</span><span class="badge">{p.level}</span><span class="badge">{p.format}</span></div><h3>{p.title}</h3><p class="desc">{p.description}</p>{!compact&&<><div class="prompt-text">{p.prompt}</div><button class="copy btn btn-secondary" data-copy={p.prompt}><span>⧉</span><span class="copy-label">Copier le prompt</span></button><details><summary>Le conseil de Papy</summary><p>{p.tips}</p><b>Variation</b><p>{p.variation}</p></details></>}{compact&&<a href={`/prompts#${p.id}`}>Voir le prompt <span>→</span></a>}</article>
<style>.prompt-card{display:flex;flex-direction:column;gap:15px}.prompt-card:before{content:"";position:absolute;width:80px;height:80px;right:-20px;top:-20px;background:#ef551a;filter:blur(55px);opacity:.18}.desc{margin:0;color:#aaa8ba}.prompt-text{font:500 .83rem/1.65 'JetBrains Mono',monospace;color:#dedce8;background:rgba(3,3,24,.62);border:1px solid rgba(255,255,255,.1);border-radius:15px;padding:16px;max-height:145px;overflow:auto}.copy{align-self:flex-start;padding:9px 13px;font-size:.8rem}.copy.copied{background:rgba(76,210,148,.16);border-color:rgba(76,210,148,.4);color:#9af1c5}details{border-top:1px solid rgba(255,255,255,.1);padding-top:12px}summary{cursor:pointer;font-weight:700;color:#ffc49c}details p{font-size:.86rem;color:#aaa8ba}a{color:#ffc49c;font-weight:750;font-size:.9rem;margin-top:auto}</style>
