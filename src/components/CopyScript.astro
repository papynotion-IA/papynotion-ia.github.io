<script>document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(b=>b.addEventListener('click',async()=>{await navigator.clipboard.writeText(b.dataset.copy||'');const label=b.querySelector('.copy-label');b.classList.add('copied');if(label)label.textContent='Copié !';setTimeout(()=>{b.classList.remove('copied');if(label)label.textContent='Copier le prompt'},1800)}));</script>
