---
import type {Resource} from '../data/resources'; const {resource:r}:{resource:Resource}=Astro.props;
---
<article class:list={['card','resource-card',{featured:r.featured}]}><div class="resource-icon">{r.type.includes('Notion')?'N':r.type.includes('PDF')?'PDF':'✦'}</div><div class="tag-row"><span class="badge">{r.type}</span><span class="badge badge-orange">{r.price}</span></div><h3>{r.title}</h3><p>{r.description}</p><a class="btn btn-secondary" href={r.url} target="_blank" rel="noreferrer">Découvrir <span>↗</span></a></article><style>.resource-card{display:flex;flex-direction:column;gap:14px}.resource-card.featured{background:linear-gradient(145deg,rgba(239,85,26,.14),rgba(255,255,255,.04))}.resource-icon{width:55px;height:55px;display:grid;place-items:center;border-radius:16px;background:#201a92;color:#f8a562;font:800 .9rem Syne}.resource-card p{color:#aaa8ba;margin:0}.resource-card a{align-self:flex-start;margin-top:auto;padding:9px 14px;font-size:.82rem}</style>
