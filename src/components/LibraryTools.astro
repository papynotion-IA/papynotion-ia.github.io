---
const {categories, placeholder='Rechercher…'}=Astro.props;
---
<div class="tools"><label><span>⌕</span><input type="search" placeholder={placeholder} aria-label={placeholder}/></label><div class="filters" aria-label="Filtrer par catégorie">{categories.map((c:string,i:number)=><button class:list={{active:i===0}} data-filter={c}>{c}</button>)}</div></div>
<script>const tools=document.querySelector<HTMLElement>('.tools');const input=tools?.querySelector<HTMLInputElement>('input');const buttons=tools?.querySelectorAll<HTMLButtonElement>('[data-filter]');const update=()=>{const q=input?.value.toLowerCase().trim()||'';const f=tools?.querySelector<HTMLButtonElement>('.active')?.dataset.filter||'Tous';let shown=0;document.querySelectorAll<HTMLElement>('[data-search]').forEach(card=>{const okQ=card.dataset.search?.includes(q);const okF=f==='Tous'||card.dataset.category?.split('|').includes(f);const show=Boolean(okQ&&okF);card.style.display=show?'':'none';if(show)shown++});const empty=document.querySelector<HTMLElement>('.empty');if(empty)empty.style.display=shown?'none':'block'};input?.addEventListener('input',update);buttons?.forEach(b=>b.addEventListener('click',()=>{buttons.forEach(x=>x.classList.remove('active'));b.classList.add('active');update()}));</script>
<style>.tools{position:relative;margin:30px 0 35px}.tools label{display:flex;align-items:center;gap:10px;max-width:540px;padding:12px 16px;border:1px solid rgba(255,255,255,.14);border-radius:14px;background:rgba(255,255,255,.06)}input{width:100%;border:0;outline:0;background:transparent;color:#fff}input::placeholder{color:#8e8c9e}.filters{display:flex;gap:8px;overflow-x:auto;padding:14px 0 4px;scrollbar-width:none}.filters button{white-space:nowrap;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.045);color:#aaa8ba;border-radius:999px;padding:8px 13px;cursor:pointer;font-size:.8rem;font-weight:700}.filters button:hover,.filters button.active{background:#ef551a;border-color:#ef551a;color:white}</style>
