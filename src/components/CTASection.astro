---
const { title="Tu veux créer plus sans te prendre la tête ?", text="Bienvenue dans l’atelier. Pioche une idée, teste-la, tords-la et fais-en quelque chose qui te ressemble.", href='/prompts', label='Entrer dans l’atelier' }=Astro.props;
---
<section class="wrap cta"><div><span class="eyebrow">À toi de jouer</span><h2>{title}</h2><p>{text}</p></div><a class="btn btn-primary" href={href}>{label} <span>→</span></a></section><style>.cta{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-block:60px 90px;padding:48px;border-radius:30px;background:radial-gradient(circle at 80% 0,rgba(248,165,98,.28),transparent 34%),linear-gradient(135deg,#201a92,#141149);border:1px solid rgba(255,255,255,.15);box-shadow:0 25px 80px rgba(0,0,0,.25)}h2{max-width:750px;margin-top:10px}p{color:#d6d4e1;max-width:650px;margin-bottom:0}.btn{flex:none}@media(max-width:700px){.cta{display:block;padding:30px}.btn{margin-top:24px}}</style>
