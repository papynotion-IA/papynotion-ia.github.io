---
const nav=[['Accueil','/'],['Prompts','/prompts'],['Astuces','/astuces'],['Ressources','/ressources'],['À propos','/a-propos'],['Liens','/contact']];
const current=Astro.url.pathname;
---
<header class="header"><div class="wrap nav"><a class="logo" href="/" aria-label="Papy AI, accueil"><span>P</span>Papy AI</a><button class="menu" aria-label="Ouvrir le menu" aria-expanded="false">Menu</button><nav aria-label="Navigation principale">{nav.map(([label,href])=><a href={href} class:list={{active:href==='/'?current===href:current.startsWith(href)}}>{label}</a>)}</nav><a class="mini-cta" href="/prompts">Piocher un prompt <b>↗</b></a></div></header>
<script>const b=document.querySelector<HTMLButtonElement>('.menu');const n=document.querySelector<HTMLElement>('.header nav');b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));n?.classList.toggle('open',!open)});</script>
<style>.header{position:fixed;z-index:20;top:0;left:0;right:0;padding:14px 0;background:rgba(10,8,35,.78);border-bottom:1px solid rgba(255,255,255,.09);backdrop-filter:blur(18px)}.nav{display:flex;align-items:center;gap:24px}.logo{display:flex;align-items:center;gap:10px;font-family:Syne;font-size:1.22rem;font-weight:800;margin-right:auto}.logo span{display:grid;place-items:center;width:35px;height:35px;border-radius:11px;background:#ef551a;box-shadow:0 8px 24px rgba(239,85,26,.3)}nav{display:flex;gap:4px}nav a{padding:8px 10px;color:#bdbbca;font-size:.87rem;font-weight:650;border-radius:8px}nav a:hover,nav a.active{color:#fff;background:rgba(255,255,255,.07)}.mini-cta{font-size:.82rem;font-weight:750;padding:9px 14px;border:1px solid rgba(248,165,98,.35);border-radius:999px;color:#ffc49c}.menu{display:none;background:transparent;color:#fff;border:1px solid rgba(255,255,255,.14);border-radius:9px;padding:7px 11px}@media(max-width:920px){.mini-cta{display:none}.menu{display:block}nav{display:none;position:absolute;top:70px;left:14px;right:14px;flex-direction:column;padding:12px;background:#141149;border:1px solid rgba(255,255,255,.12);border-radius:16px;box-shadow:0 20px 40px #050419}nav.open{display:flex}nav a{padding:12px 14px}}</style>
