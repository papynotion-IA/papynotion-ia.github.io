---
import BaseLayout from '../layouts/BaseLayout.astro';import SectionTitle from '../components/SectionTitle.astro';import PromptCard from '../components/PromptCard.astro';import TipCard from '../components/TipCard.astro';import CTASection from '../components/CTASection.astro';import Mascot from '../components/Mascot.astro';import {prompts} from '../data/prompts';import {tips} from '../data/tips';
const finds=[['01','Prompts Midjourney','Des directions visuelles précises pour aller plus loin que “fais-moi un truc joli”.','/prompts'],['02','Astuces IA','Des conseils courts, testés et applicables avant que ton café refroidisse.','/astuces'],['03','Ressources gratuites','Des guides et outils prêts à l’emploi, sans piège ni tunnel infernal.','/ressources'],['04','Clips & expériences','Des tests, des morceaux et des curiosités pour voir jusqu’où on peut jouer.','/contact']];
---
<BaseLayout><section class="hero"><div class="wrap hero-grid"><div><span class="eyebrow">Bienvenue dans l’atelier IA</span><h1>Crée plus.<br/><span>Amuse-toi plus.</span><br/>Laisse l’IA bosser un peu.</h1><p class="lead">Prompts, astuces, ressources et expériences créatives autour de l’IA générative.</p><div class="actions"><a class="btn btn-primary" href="/prompts">Explorer les prompts →</a><a class="btn btn-secondary" href="/astuces">Découvrir les astuces</a><a class="text-link" href="/ressources">Voir les ressources ↗</a></div></div><div class="lab"><Mascot pose="wave" size="lg" label="Papy AI te souhaite la bienvenue"/><div class="float f1">PROMPT_01<br/><b>une idée bien habillée</b></div><div class="float f2">MODE CRÉATIF <i></i></div><div class="float f3">✦ TESTER<br/>↳ JOUER<br/>↳ RECOMMENCER</div></div></div><div class="wrap ticker"><span>Dans la boîte à outils</span><div>Midjourney ✦ ChatGPT ✦ Suno ✦ Claude ✦ Notion ✦ et beaucoup de curiosité</div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><SectionTitle eyebrow="Au menu" title="Ce que tu trouveras ici" text="Pas de théorie qui prend la poussière. Des points de départ concrets pour créer, tester et trouver ta façon de faire."/></div><div class="grid grid-4 find-grid">{finds.map(([n,t,d,h])=><a class="card find" href={h}><span>{n}</span><h3>{t}</h3><p>{d}</p><b>Explorer →</b></a>)}</div></div></section>
<section class="section dark-band"><div class="wrap"><div class="section-head"><SectionTitle eyebrow="À copier, puis à tordre" title="Derniers prompts" text="Des recettes de départ pour l’image, le texte, la musique et tout ce qui refuse de rentrer dans une case."/><a class="btn btn-secondary" href="/prompts">Voir toute la bibliothèque</a></div><div class="card-companion"><div class="grid grid-3">{prompts.slice(0,3).map(prompt=><PromptCard prompt={prompt} compact/>)}</div><Mascot pose="point" label="Papy AI montre les derniers prompts"/></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><SectionTitle eyebrow="Petit raccourci, grand effet" title="Dernières astuces" text="Quelques minutes de lecture. Beaucoup moins de temps perdu à tourner en rond."/><a class="btn btn-secondary" href="/astuces">Toutes les astuces</a></div><div class="card-companion companion-left"><Mascot pose="think" label="Papy AI réfléchit à une astuce" flip/><div class="grid grid-3">{tips.slice(0,3).map(tip=><TipCard tip={tip} compact/>)}</div></div></div></section>
<section class="section"><div class="wrap about-home"><div class="portrait"><div class="face">P</div><span>Humain<br/>augmenté,<br/><b>jamais remplacé.</b></span></div><div><span class="eyebrow">Salut, c’est Papy AI</span><h2>La curiosité n’a pas d’âge.</h2><p class="lead">Je partage ce que je découvre autour de l’IA générative : des prompts utiles, des astuces sans jargon, des clips un peu étranges et les outils que j’aurais aimé trouver en commençant.</p><a class="btn btn-secondary" href="/a-propos">Faire connaissance →</a></div></div></section><CTASection/></BaseLayout>
<style>.hero{min-height:100vh;padding:150px 0 40px;display:flex;flex-direction:column;justify-content:space-between}.hero-grid{display:grid;grid-template-columns:1.25fr .75fr;align-items:center;gap:40px}.hero h1{margin-top:17px}.hero h1 span{color:#f8a562}.hero .lead{margin:25px 0 28px}.text-link{display:flex;align-items:center;padding:13px 10px;color:#bbb9c9;font-weight:700}.lab{position:relative;min-height:520px;display:flex;align-items:flex-end;justify-content:center}.lab :global(.mascot){animation:drift 6s ease-in-out infinite}.float{position:absolute;z-index:3;padding:12px 15px;border:1px solid rgba(255,255,255,.16);border-radius:12px;background:rgba(10,8,35,.72);backdrop-filter:blur(12px);font:500 .69rem/1.5 'JetBrains Mono';box-shadow:0 14px 35px rgba(0,0,0,.25)}.float b{color:#f8a562}.f1{top:45px;left:0}.f2{right:-15px;top:200px}.f2 i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#65e1a3;box-shadow:0 0 10px #65e1a3}.f3{bottom:25px;left:20px;color:#c6c4d2}.ticker{display:flex;gap:30px;align-items:center;border-top:1px solid rgba(255,255,255,.1);padding-top:22px;color:#8f8d9e;font-size:.82rem;text-transform:uppercase;letter-spacing:.07em}.ticker span{color:#f8a562;font-weight:800}.find{min-height:245px;display:flex;flex-direction:column}.find>span{font:700 .75rem 'JetBrains Mono';color:#f8a562}.find h3{font-size:1.65rem;margin-top:25px}.find p{color:#aaa8ba}.find b{margin-top:auto;color:#f8a562;font-size:.85rem}.dark-band{background:rgba(5,4,25,.25);border-block:1px solid rgba(255,255,255,.07)}.card-companion{display:grid;grid-template-columns:minmax(0,1fr) 220px;align-items:end;gap:10px}.companion-left{grid-template-columns:190px minmax(0,1fr)}.card-companion :global(.mascot){margin-bottom:-26px}.about-home{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;align-items:center}.portrait{min-height:410px;border-radius:30px;background:linear-gradient(140deg,#201a92,#ef551a);position:relative;display:grid;place-items:center;overflow:hidden}.portrait:before{content:"";position:absolute;width:320px;height:320px;border:1px solid rgba(255,255,255,.3);border-radius:50%;box-shadow:0 0 0 40px rgba(255,255,255,.04),0 0 0 80px rgba(255,255,255,.03)}.face{font:800 9rem Syne;color:#fff;z-index:1}.portrait span{position:absolute;bottom:22px;left:24px;font:700 .8rem 'JetBrains Mono';text-transform:uppercase}.portrait b{color:#090851}.about-home h2{margin:13px 0 24px}.about-home .btn{margin-top:14px}@keyframes drift{50%{transform:translateY(-12px) rotate(2deg)}}@media(max-width:1050px){.card-companion,.companion-left{grid-template-columns:1fr}.card-companion :global(.mascot){order:2;margin:15px auto -30px}.companion-left :global(.mascot){order:2}}@media(max-width:900px){.hero{min-height:auto}.hero-grid{grid-template-columns:1fr}.lab{min-height:430px;width:min(500px,100%);margin:auto}.about-home{grid-template-columns:1fr}.portrait{min-height:350px}.ticker{margin-top:30px;overflow:hidden;white-space:nowrap}}@media(max-width:560px){.hero{padding-top:125px}.lab{min-height:360px}.f2{right:0}.ticker{display:block}.ticker span{display:block;margin-bottom:6px}}</style>
