---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PromptCard from '../components/PromptCard.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import Mascot from '../components/Mascot.astro';
import CTASection from '../components/CTASection.astro';
import { prompts } from '../data/prompts';
const paths=[
  {n:'01',title:'Créer une image',text:'Des prompts visuels avec le résultat sous les yeux.',href:'/prompts',tag:'Midjourney · Graphisme'},
  {n:'02',title:'Trouver les bons mots',text:'Des structures pour écrire sans sonner comme une machine.',href:'/prompts',tag:'ChatGPT · Claude'},
  {n:'03',title:'Organiser tes idées',text:'Des méthodes légères pour créer sans usine à gaz.',href:'/astuces',tag:'Notion · Workflow'},
];
---
<BaseLayout>
  <section class="hero-editorial">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">L’atelier créatif augmenté</span>
        <h1>Crée avec l’IA.<br/><span>Garde le plaisir.</span></h1>
        <p class="lead">Des prompts testés, des astuces simples et des ressources prêtes à utiliser pour transformer une idée en création.</p>
        <div class="actions"><a class="btn btn-primary" href="/prompts">Explorer les prompts →</a><a class="btn btn-secondary" href="#kit-gratuit">Télécharger le kit gratuit</a></div>
        <div class="proof-line"><span>En français</span><span>Sans jargon</span><span>Pour tester aujourd’hui</span></div>
      </div>
      <div class="hero-studio">
        <div class="studio-frame"><Mascot pose="wave" size="lg" label="Papy AI te souhaite la bienvenue"/></div>
        <div class="studio-note note-one"><b>12</b><span>prompts<br/>pour démarrer</span></div>
        <div class="studio-note note-two"><span>OUTILS</span><b>5+</b></div>
        <div class="studio-swatch"><i></i><i></i><i></i><i></i></div>
      </div>
    </div>
    <div class="wrap tool-line"><b>Dans l’atelier</b><span>Midjourney</span><span>ChatGPT</span><span>Claude</span><span>Suno</span><span>Notion</span></div>
  </section>

  <section class="section creations"><div class="wrap">
    <div class="section-head"><SectionTitle eyebrow="Prompt → résultat" title="Ici, on montre ce que ça crée." text="Chaque idée part d’un prompt, mais c’est le résultat qui donne envie d’essayer."/><a class="btn btn-secondary" href="/prompts">Voir les prompts</a></div>
    <div class="showcase-grid">
      <ShowcaseCard number="01" tool="Midjourney" title="Un laboratoire dans une cassette" text="Image éditoriale rétro-futuriste." image="/editorial/prompt-visual.webp" href="/prompts#affiche-retro"/>
      <ShowcaseCard number="02" tool="ChatGPT" title="Une idée devient un post" text="Du brouillon à une structure claire." image="/editorial/prompt-writing.webp" href="/prompts#post-linkedin"/>
      <ShowcaseCard number="03" tool="Suno" title="Le dimanche en musique" text="Une direction sonore avec une vraie intention." image="/editorial/prompt-music.webp" href="/prompts#chanson-solaire"/>
    </div>
  </div></section>

  <section class="section path-section"><div class="wrap">
    <SectionTitle eyebrow="Choisis ton point de départ" title="Tu veux créer quoi aujourd’hui ?" text="Pas besoin de tout parcourir. Commence par ton envie du moment."/>
    <div class="path-grid">{paths.map(p=><a class="path-card" href={p.href}><span>{p.n}</span><small>{p.tag}</small><h3>{p.title}</h3><p>{p.text}</p><b>Commencer →</b></a>)}</div>
  </div></section>

  <section class="section" id="kit-gratuit"><div class="wrap"><LeadMagnet/></div></section>

  <section class="section popular"><div class="wrap">
    <div class="section-head"><SectionTitle eyebrow="Testés dans l’atelier" title="Les prompts à essayer maintenant" text="Trois points de départ concrets, avec un aperçu du terrain de jeu."/><a class="btn btn-secondary" href="/prompts">Toute la promptothèque</a></div>
    <div class="grid grid-3 prompt-showcase">{prompts.slice(0,3).map(prompt=><PromptCard prompt={prompt} compact/>)}</div>
  </div></section>

  <section class="section tip-feature"><div class="wrap tip-layout">
    <div class="tip-mascot"><Mascot pose="think" size="lg" label="Papy AI réfléchit à une meilleure formulation" flip/><span>ASTUCE<br/>DE L’ATELIER</span></div>
    <div class="tip-copy"><span class="eyebrow">Avant / après</span><h2>Une contrainte peut libérer l’idée.</h2><p>Un prompt trop ouvert donne souvent une réponse tiède. Ajoute un public, une durée ou une limite de production.</p>
      <div class="compare"><div><small>AVANT</small><p>« Donne-moi des idées de vidéos. »</p></div><div class="after"><small>APRÈS</small><p>« Propose 5 concepts de vidéos réalisables seul, en 20 minutes, sans montrer mon visage. »</p></div></div>
      <a class="text-cta" href="/astuces">Voir toutes les astuces →</a>
    </div>
  </div></section>

  <section class="section workflow"><div class="wrap"><SectionTitle eyebrow="La méthode maison" title="De l’idée au résultat, sans magie noire." text="Un workflow simple que tu peux réutiliser avec presque tous les outils."/>
    <div class="workflow-grid"><div><span>01</span><b>Une intention</b><p>Ce que tu veux faire ressentir ou obtenir.</p></div><div><span>02</span><b>Un prompt</b><p>Une idée bien habillée, avec quelques limites utiles.</p></div><div><span>03</span><b>Un premier jet</b><p>Quelque chose à regarder, écouter ou corriger.</p></div><div><span>04</span><b>Ta touche</b><p>Le goût, les choix et les détails qui rendent le résultat vivant.</p></div></div>
  </div></section>

  <section class="section about-studio"><div class="wrap about-layout"><div><span class="eyebrow">Derrière l’écran</span><h2>La curiosité n’a pas d’âge.</h2><p class="lead">Je teste les outils, je garde ce qui fonctionne et je te l’explique simplement. Pas pour créer à ta place, mais pour t’aider à aller plus loin avec tes idées.</p><div class="values"><span>En français</span><span>Testé concrètement</span><span>Régulièrement enrichi</span></div><a class="btn btn-secondary" href="/a-propos">Faire connaissance →</a></div><div class="about-visual"><Mascot pose="point" size="lg" label="Papy AI montre une idée à tester"/><div class="quote-card">« Un bon prompt, c’est une bonne idée bien habillée. »</div></div></div></section>

  <CTASection title="Commence par une création, pas par un mode d’emploi." text="Pioche un prompt, adapte trois mots et fabrique une première version. Elle n’a pas besoin d’être parfaite pour exister." href="/prompts" label="Piocher un prompt"/>
</BaseLayout>

<style>
  .hero-editorial{padding:130px 0 32px;min-height:94vh;display:flex;flex-direction:column;justify-content:space-between}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}.hero-copy h1{margin:14px 0 22px}.hero-copy h1 span{color:#ff7a00}.hero-copy .lead{max-width:640px}.hero-copy .actions{margin:28px 0 22px}.proof-line{display:flex;flex-wrap:wrap;gap:8px}.proof-line span{padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#bbb9c9;font-size:.72rem;font-weight:700}.hero-studio{position:relative;min-height:530px;display:grid;place-items:end center}.studio-frame{position:absolute;inset:20px 40px 0;border-radius:30px;background:radial-gradient(circle at 50% 28%,rgba(255,122,0,.35),transparent 30%),linear-gradient(145deg,#201a92,#0f0d42);border:1px solid rgba(255,255,255,.13);overflow:hidden;box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 28px 70px rgba(0,0,0,.22)}.studio-frame :global(.mascot){position:absolute;bottom:-150px;left:50%;transform:translateX(-50%);width:420px}.studio-note{position:absolute;z-index:3;display:flex;align-items:center;gap:10px;padding:12px 15px;border-radius:14px;background:rgba(10,8,35,.88);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(12px);box-shadow:0 16px 35px rgba(0,0,0,.25)}.studio-note b{color:#ff7a00;font:800 1.6rem Syne}.studio-note span{font:700 .65rem/1.3 'JetBrains Mono';text-transform:uppercase}.note-one{left:0;top:110px}.note-two{right:0;bottom:75px}.studio-swatch{position:absolute;z-index:4;right:40px;top:48px;display:flex;gap:4px}.studio-swatch i{width:14px;height:14px;border-radius:50%;background:#ff7a00}.studio-swatch i:nth-child(2){background:#f9f6f4}.studio-swatch i:nth-child(3){background:#201a92}.studio-swatch i:nth-child(4){background:#0a0823;border:1px solid #777}.tool-line{display:flex;align-items:center;gap:24px;padding-top:22px;border-top:1px solid rgba(255,255,255,.1);color:#8f8d9d;text-transform:uppercase;letter-spacing:.07em;font-size:.72rem}.tool-line b{color:#ff8d26}.creations{background:#f9f6f4;color:#0a0823}.creations :global(.eyebrow){color:#b74200}.creations :global(.section-head p){color:#5e5966}.creations .btn{color:#0a0823;border-color:rgba(10,8,35,.18)}.showcase-grid{display:grid;grid-template-columns:1.15fr .85fr .85fr;gap:18px}.path-section{background:#0a0823}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:36px}.path-card{position:relative;min-height:285px;padding:27px;border:1px solid rgba(255,255,255,.12);border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.08),rgba(255,255,255,.025));display:flex;flex-direction:column;transition:.22s}.path-card:hover{transform:translateY(-4px);border-color:rgba(255,122,0,.45)}.path-card>span{position:absolute;right:22px;top:20px;color:#ff7a00;font:700 .72rem 'JetBrains Mono'}.path-card small{color:#8f8c9d;text-transform:uppercase;font-weight:800;letter-spacing:.06em}.path-card h3{font-size:1.8rem;margin:35px 0 10px}.path-card p{color:#aaa8ba}.path-card b{margin-top:auto;color:#ff8d26}.popular{border-block:1px solid rgba(255,255,255,.08)}.tip-feature{background:#f9f6f4;color:#0a0823}.tip-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:65px;align-items:center}.tip-mascot{position:relative;min-height:520px;display:flex;align-items:flex-end;justify-content:center;border-radius:28px;background:linear-gradient(145deg,#201a92,#090851);overflow:hidden}.tip-mascot :global(.mascot){height:500px}.tip-mascot :global(.mascot img){height:100%;width:auto}.tip-mascot>span{position:absolute;left:20px;top:20px;color:#ff7a00;font:700 .72rem/1.5 'JetBrains Mono'}.tip-copy :global(.eyebrow){color:#b74200}.tip-copy h2{margin:12px 0 18px}.tip-copy>p{color:#575260;font-size:1.05rem}.compare{display:grid;gap:10px;margin:26px 0}.compare>div{padding:18px;border-radius:16px;background:#e9e5e1}.compare .after{background:#0a0823;color:#fff}.compare small{color:#9b3a00;font-weight:900;letter-spacing:.1em}.compare p{margin:5px 0 0;font-weight:700}.text-cta{color:#9b3a00;font-weight:800}.workflow-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:38px;border-block:1px solid rgba(255,255,255,.12)}.workflow-grid>div{padding:28px 24px;border-right:1px solid rgba(255,255,255,.12)}.workflow-grid>div:last-child{border:0}.workflow-grid span{color:#ff7a00;font:700 .72rem 'JetBrains Mono'}.workflow-grid b{display:block;font:700 1.3rem Syne;margin:32px 0 8px}.workflow-grid p{color:#aaa8ba;margin:0;font-size:.88rem}.about-studio{background:linear-gradient(145deg,rgba(32,26,146,.38),transparent)}.about-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:65px;align-items:center}.about-layout h2{margin:12px 0 20px}.values{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.values span{padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);font-size:.75rem;font-weight:700}.about-visual{position:relative;min-height:460px;display:flex;justify-content:center;align-items:flex-end}.quote-card{position:absolute;right:0;bottom:28px;z-index:4;max-width:260px;padding:18px;border-radius:16px;background:#f9f6f4;color:#0a0823;font:700 1rem/1.4 Syne;box-shadow:0 18px 50px rgba(0,0,0,.3)}
  @media(max-width:900px){.hero-grid,.about-layout,.tip-layout{grid-template-columns:1fr}.hero-editorial{min-height:auto}.hero-studio{min-height:480px}.showcase-grid{grid-template-columns:1fr 1fr}.showcase-grid>:first-child{grid-column:1/-1}.path-grid{grid-template-columns:1fr}.workflow-grid{grid-template-columns:1fr 1fr}.workflow-grid>div:nth-child(2){border-right:0}.tool-line{overflow:auto}.tip-mascot{min-height:420px}.tip-mascot :global(.mascot){height:410px}}
  @media(max-width:600px){.hero-editorial{padding-top:118px}.hero-copy h1{font-size:clamp(3.1rem,14vw,4.2rem)}.hero-copy .actions .btn{width:100%}.hero-studio{min-height:390px}.studio-frame{inset:10px 8px 0}.studio-frame :global(.mascot){width:310px;bottom:-115px}.note-one{left:0;top:70px}.note-two{right:0;bottom:35px}.tool-line{gap:16px}.showcase-grid{grid-template-columns:1fr}.showcase-grid>:first-child{grid-column:auto}.workflow-grid{grid-template-columns:1fr}.workflow-grid>div{border-right:0;border-bottom:1px solid rgba(255,255,255,.12)}.tip-layout{gap:30px}.about-layout{gap:25px}.about-visual{min-height:380px}.quote-card{right:5px}.proof-line{display:none}}
</style>
