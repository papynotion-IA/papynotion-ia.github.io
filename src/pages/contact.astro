---
import BaseLayout from '../layouts/BaseLayout.astro';import {socialLinks,contactEmail} from '../data/site';const notes={Threads:'Idées fraîches, tests et conversations',Instagram:'Visuels, carrousels et coulisses créatives',YouTube:'Tutos, expériences et clips IA',Gumroad:'Guides, templates et packs de prompts'};
---
<BaseLayout title="Retrouver Papy AI — Liens & contact" description="Tous les liens de Papy AI : Threads, Instagram, YouTube, Gumroad et contact."><section class="top-space section"><div class="wrap"><span class="eyebrow">Restons connectés</span><h1>Retrouve-moi<br/><span class="accent">dans la vraie vie numérique.</span></h1><p class="lead">Choisis ton coin d’internet préféré. J’y partage des expériences, des ressources et probablement une idée testée trop tard le soir.</p><div class="social-grid">{socialLinks.map((s,i)=><a class="card social" href={s.url} target="_blank" rel="noreferrer"><span class="num">0{i+1}</span><div><h2>{s.name}</h2><p>{notes[s.name as keyof typeof notes]}</p><b>{s.label}</b></div><span class="arrow">↗</span></a>)}</div><div class="mail"><div><span class="eyebrow">Une idée, une question, un bonjour ?</span><h2>Écris-moi.</h2><p>Pour une collaboration ou simplement partager ce que tu as créé.</p></div><a class="btn btn-primary" href={`mailto:${contactEmail}`}>{contactEmail}</a></div></div></section></BaseLayout><style>h1{margin:15px 0 22px;max-width:1000px}.social-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:50px}.social{display:grid;grid-template-columns:48px 1fr auto;gap:16px;align-items:start}.num{font:600 .72rem 'JetBrains Mono';color:#ef551a}.social h2{font-size:2rem}.social p{color:#aaa8ba;margin:8px 0 12px}.social b{color:#f8a562;font-size:.85rem}.arrow{font-size:1.5rem}.mail{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-top:70px;padding:44px;border-radius:28px;background:linear-gradient(130deg,#201a92,rgba(239,85,26,.55));border:1px solid rgba(255,255,255,.14)}.mail h2{margin-top:10px}.mail p{margin-bottom:0;color:#d6d4e1}@media(max-width:760px){.social-grid{grid-template-columns:1fr}.mail{display:block;padding:28px}.mail .btn{margin-top:22px}}</style>
