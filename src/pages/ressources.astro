---
import BaseLayout from '../layouts/BaseLayout.astro';import ResourceCard from '../components/ResourceCard.astro';import CTASection from '../components/CTASection.astro';import Mascot from '../components/Mascot.astro';import {resources} from '../data/resources';const free=resources.filter(r=>r.price==='Gratuit');const paid=resources.filter(r=>r.price!=='Gratuit');
---
<BaseLayout title="Ressources créatives IA — Papy AI" description="Guides, packs de prompts et templates Notion pour créer davantage avec l’IA."><section class="top-space section"><div class="wrap"><span class="eyebrow">La réserve à outils</span><h1>Des ressources pour<br/><span class="accent">passer à l’action.</span></h1><p class="lead">Des guides, templates et packs conçus pour t’aider vraiment. Pas pour finir dans ton dossier Téléchargements.</p></div></section><section class="section resource-section"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Pour commencer</span><h2>Ressources gratuites</h2><p>Prends, teste, transforme. C’est cadeau.</p></div></div><div class="resource-companion"><div class="grid grid-2">{free.map(r=><ResourceCard resource={r}/>)}</div><Mascot pose="point" label="Papy AI présente les ressources gratuites"/></div></div></section><section class="section"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Pour aller plus loin</span><h2>Packs, guides & templates</h2><p>Des raccourcis solides, construits avec soin et une légère obsession du détail.</p></div></div><div class="resource-companion reverse"><Mascot pose="win" label="Papy AI célèbre tes futures créations" flip/><div class="grid grid-3">{paid.map(r=><ResourceCard resource={r}/>)}</div></div></div></section><CTASection title="Le bon outil est celui que tu utilises." text="Commence par le kit gratuit. S’il t’aide à fabriquer quelque chose, il a déjà fait son travail." href="https://papyai.gumroad.com" label="Visiter la boutique ↗"/></BaseLayout><style>h1{margin:15px 0 20px}.resource-section{background:rgba(5,4,25,.25);border-block:1px solid rgba(255,255,255,.07)}.section-head h2{margin-top:10px}.section-head p{color:#aaa8ba}.resource-companion{display:grid;grid-template-columns:minmax(0,1fr) 220px;align-items:end;gap:18px}.resource-companion.reverse{grid-template-columns:200px minmax(0,1fr)}.resource-companion :global(.mascot){margin-bottom:-30px}@media(max-width:1000px){.resource-companion,.resource-companion.reverse{grid-template-columns:1fr}.resource-companion :global(.mascot){margin:15px auto -30px}.resource-companion.reverse :global(.mascot){order:2}}</style>
