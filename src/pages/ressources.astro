---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import CTASection from '../components/CTASection.astro';
import {resources} from '../data/resources';
const free=resources.filter(r=>r.price==='Gratuit');
const paid=resources.filter(r=>r.price!=='Gratuit');
---
<BaseLayout title="Ressources créatives IA | Papy AI" description="Guides, packs de prompts et templates Notion pour créer davantage avec l’IA.">
  <section class="top-space section resource-hero"><div class="wrap resource-intro"><div><span class="eyebrow">La réserve à outils</span><h1>Moins chercher.<br/><span class="accent">Plus créer.</span></h1><p class="lead">Des guides, templates et packs conçus pour être ouverts, compris et utilisés. Pas pour finir dans ton dossier Téléchargements.</p><div class="trust"><span>Contenu en français</span><span>Formats simples</span><span>Créé par Papy AI</span></div></div><div class="hero-cover"><img src="/editorial/starter-kit.webp" alt="Aperçu des ressources Papy AI" width="900" height="675"/><span>OUTILS CRÉATIFS</span></div></div></section>
  <section class="section free-feature" id="kit-gratuit"><div class="wrap"><LeadMagnet compact/></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Pour commencer</span><h2>Ressources gratuites</h2><p>Prends, teste et transforme. C’est cadeau.</p></div></div><div class="grid grid-2 resource-grid">{free.map(r=><ResourceCard resource={r}/>)}</div></div></section>
  <section class="section paid-section"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Pour aller plus loin</span><h2>Packs, guides & templates</h2><p>Chaque fiche montre le format, ce qu’elle contient et le point de départ concret.</p></div></div><div class="grid grid-3 resource-grid">{paid.map(r=><ResourceCard resource={r}/>)}</div><p class="store-note">Les fiches produits sont regroupées sur la boutique Gumroad de Papy AI. Les liens directs seront ajoutés au fil des publications.</p></div></section>
  <CTASection title="Le bon outil est celui que tu utilises." text="Commence par une ressource gratuite. Si elle t’aide à fabriquer quelque chose, elle a déjà fait son travail." href="#kit-gratuit" label="Commencer gratuitement"/>
</BaseLayout>
<style>
  .resource-intro{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}.resource-intro h1{margin:15px 0 20px}.trust{display:flex;flex-wrap:wrap;gap:8px;margin-top:25px}.trust span{padding:7px 11px;border:1px solid rgba(255,255,255,.12);border-radius:999px;color:#bbb9c9;font-size:.74rem;font-weight:700}.hero-cover{position:relative;min-height:420px;border-radius:28px;overflow:hidden;border:1px solid rgba(255,255,255,.12)}.hero-cover img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.hero-cover span{position:absolute;left:18px;bottom:18px;padding:7px 11px;border-radius:999px;background:#ff7a00;color:#090851;font-size:.7rem;font-weight:900;letter-spacing:.08em}.free-feature{background:rgba(5,4,25,.28);border-block:1px solid rgba(255,255,255,.07)}.section-head h2{margin-top:10px}.section-head p{color:#aaa8ba}.paid-section{background:#f9f6f4;color:#0a0823}.paid-section :global(.eyebrow){color:#b74200}.paid-section .section-head p{color:#5e5966}.store-note{margin-top:24px;color:#6f6a76;font-size:.78rem}
  @media(max-width:800px){.resource-intro{grid-template-columns:1fr}.hero-cover{min-height:280px}.resource-hero{padding-bottom:30px}}
</style>
