---
import BaseLayout from '../layouts/BaseLayout.astro';import TipCard from '../components/TipCard.astro';import LibraryTools from '../components/LibraryTools.astro';import CTASection from '../components/CTASection.astro';import Mascot from '../components/Mascot.astro';import {tips} from '../data/tips';const cats=['Toutes',...new Set(tips.map(t=>t.category))];
---
<BaseLayout title="Astuces IA simples et utiles — Papy AI" description="Des astuces courtes pour mieux prompter, créer des images, organiser ses idées et gagner du temps avec l’IA."><section class="top-space section"><div class="wrap"><div class="page-intro"><Mascot pose="think" size="md" label="Papy AI cherche une bonne astuce" flip/><div><span class="eyebrow">Le carnet de bord</span><h1>Moins de blabla.<br/><span class="accent">Plus de déclics.</span></h1><p class="lead">Des mini-guides concrets pour mieux travailler avec l’IA sans devoir parler robot.</p></div></div><LibraryTools categories={cats.map((c,i)=>i===0?'Tous':c)} placeholder="Chercher une astuce…"/><div class="grid grid-2 tips">{tips.map(t=><div id={t.slug}><TipCard tip={t}/></div>)}</div><div class="empty">Pas de résultat. Tente un mot plus simple ou enlève le filtre.</div></div></section><CTASection title="La meilleure astuce ? Faire un essai." text="Choisis une idée, applique-la aujourd’hui et observe ce qui change. Le reste viendra en jouant."/></BaseLayout><style>.page-intro{display:grid;grid-template-columns:230px 1fr;align-items:end;gap:25px}.page-intro :global(.mascot){margin-bottom:-75px}h1{margin:15px 0 20px}.tips>div{display:flex;scroll-margin-top:110px}.tips article{width:100%}@media(max-width:700px){.page-intro{grid-template-columns:1fr}.page-intro :global(.mascot){order:2;margin:20px auto -45px}}</style>
