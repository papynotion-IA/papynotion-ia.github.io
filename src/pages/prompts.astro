---
import BaseLayout from '../layouts/BaseLayout.astro';import PromptCard from '../components/PromptCard.astro';import LibraryTools from '../components/LibraryTools.astro';import CopyScript from '../components/CopyScript.astro';import CTASection from '../components/CTASection.astro';import Mascot from '../components/Mascot.astro';import {prompts,promptCategories} from '../data/prompts';
---
<BaseLayout title="Prompts IA à copier | Papy AI" description="Une bibliothèque de prompts en français pour Midjourney, ChatGPT, Claude, Suno et Notion."><section class="top-space section"><div class="wrap"><div class="page-intro"><div><span class="eyebrow">La promptothèque</span><h1>Une bonne idée,<br/><span class="accent">bien habillée.</span></h1><p class="lead">Copie, adapte, expérimente. Ces prompts sont des tremplins, pas des cages.</p></div><Mascot pose="point" size="md" label="Papy AI montre la bibliothèque de prompts"/></div><LibraryTools categories={promptCategories} placeholder="Chercher un outil, une idée, un format…"/><div class="grid grid-2 prompt-grid">{prompts.map(p=><div id={p.id}><PromptCard prompt={p}/></div>)}</div><div class="empty">Aucun prompt par ici. Essaie un autre mot, la machine n’est pas vexée.</div></div></section><CTASection title="Un prompt n’est jamais vraiment fini." text="Change un mot, ajoute une contrainte, injecte ton goût. C’est là que le résultat devient le tien." href="/astuces" label="Apprendre à mieux prompter"/><CopyScript/></BaseLayout><style>.page-intro{display:grid;grid-template-columns:1fr 230px;align-items:end}.page-intro :global(.mascot){margin-bottom:-75px}h1{margin:15px 0 20px}.lead{margin-bottom:0}.prompt-grid>div{display:flex;scroll-margin-top:110px}.prompt-grid article{width:100%}@media(max-width:700px){.page-intro{grid-template-columns:1fr}.page-intro :global(.mascot){margin:20px auto -45px}}</style>
